# Padrão de editor do monorepo: UTF-8, LF, 2 espaços e nova linha no fim (o Java segue o google-java-format).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf
